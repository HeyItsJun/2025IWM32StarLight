@model IEnumerable<Starlight.Models.Experience>

@{
    ViewBag.Title = "Index";
}

<link href="https://fonts.googleapis.com/css2?family=Shrikhand&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">

<style>
    :root {
        --accent-color: #F2D5DD;
        --dark-color: #011526;
        --mid-color: #184D59;
        --highlight: #F29D52;
        --contrast: #F28B66;
        --body-font: 'VT323', monospace;
        --title-font: 'Shrikhand', sans-serif;
    }

    body {
        font-family: var(--body-font);
        margin: 0;
        padding: 0;
        background-color: var(--dark-color);
        color: var(--accent-color);
    }

    main {
        padding: 2rem 3rem;
    }

    header h1 {
        font-family: var(--title-font);
        font-size: clamp(2rem, 4vw, 3rem);
        color: var(--highlight);
        text-shadow: 0 4px 10px rgba(0,0,0,0.3);
        margin-bottom: 0.5rem;
    }

    .hero-subtitle {
        font-family: var(--body-font);
        color: var(--accent-color);
        opacity: 0.85;
        margin-bottom: 2rem;
    }

    .controls {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

        .controls a.btn {
            padding: 0.6rem 1rem;
            border-radius: 6px;
            background: var(--mid-color);
            color: var(--accent-color);
            text-decoration: none;
            font-weight: 600;
            transition: background 0.2s ease, transform 0.2s ease;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }

            .controls a.btn:hover {
                background: var(--highlight);
                color: var(--dark-color);
                transform: translateY(-3px);
            }

    table {
        width: 100%;
        border-collapse: collapse;
        background-color: rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        overflow: hidden;
    }

    th, td {
        padding: 0.9rem 1rem;
        text-align: left;
        color: #ffffff;
    }

    th {
        background-color: var(--mid-color);
        color: var(--accent-color);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
    }

    tr:nth-child(even) {
        background-color: rgba(255, 255, 255, 0.04);
    }

    tr:hover {
        background-color: rgba(255, 255, 255, 0.08);
        transition: background 0.2s ease;
    }

    .actions a {
        color: var(--highlight);
        text-decoration: none;
        font-weight: 600;
        margin-right: .45rem;
    }

        .actions a:hover {
            color: var(--contrast);
            text-decoration: underline;
        }

    .actions .sep {
        color: rgba(255,255,255,0.55);
        margin: 0 .35rem;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 520px) {
        main {
            padding: 1rem;
        }

        header h1 {
            font-size: 1.8rem;
        }

        table {
            font-size: 0.9rem;
        }
    }
</style>

<main>
    <header>
        <h1>Experiencias</h1>
        <p class="hero-subtitle">Descubre la lista de experiencias disponibles</p>
    </header>

    <div class="controls" role="toolbar" aria-label="Controles de lista">
        <p style="margin:0" class="muted" aria-hidden="true">
            @(Model != null ? Model.Count() : 0) items
        </p>
        <a class="btn" href="@Url.Action("Create")" role="button" aria-label="Crear nueva experiencia">Crear nuevo</a>
    </div>

    <table class="table" role="table" aria-describedby="experienceListDescription">
        <thead>
            <tr>
                <th>Tipo de Experiencia</th>
                <th>Ubicación</th>
                <th>Descripción</th>
                <th>Tipo de Ubicación</th>
                <th>Pueblo/Ciudad</th>
                <th>Provincia</th>
                <th>Comunidad Autónoma</th>
                <th>País</th>
                <th>@Html.DisplayNameFor(model => model.Sponsor)</th>
                <th>Precio</th>
                <th>Duración</th>
                <th class="muted" aria-hidden="true">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.ExperienceType)</td>
                    <td>@Html.DisplayFor(modelItem => item.Location)</td>
                    <td>@Html.DisplayFor(modelItem => item.Description)</td>
                    <td>@Html.DisplayFor(modelItem => item.LocationType)</td>
                    <td>@Html.DisplayFor(modelItem => item.CityTown)</td>
                    <td>@Html.DisplayFor(modelItem => item.Province)</td>
                    <td>@Html.DisplayFor(modelItem => item.Community)</td>
                    <td>@Html.DisplayFor(modelItem => item.Country)</td>
                    <td>@Html.DisplayFor(modelItem => item.Sponsor)</td>
                    <td>@Html.DisplayFor(modelItem => item.Price)</td>
                    <td>@Html.DisplayFor(modelItem => item.Duration)</td>
                    <td class="actions" role="group" aria-label="Acciones por experiencia">
                        @Html.ActionLink("Edit", "Edit", new { id = item.ExperienceID }, new { title = "Editar " + item.ExperienceType })
                        <span class="sep">|</span>
                        @Html.ActionLink("Details", "Details", new { id = item.ExperienceID }, new { title = "Detalles de " + item.ExperienceType })
                        <span class="sep">|</span>
                        @Html.ActionLink("Delete", "Delete", new { id = item.ExperienceID }, new { title = "Eliminar " + item.ExperienceType })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</main>