@using Starlight.Models
@model LoginViewModel

@{
    ViewBag.Title = "Log in";
}

<style>
    body.login-page {
        background: linear-gradient(270deg, #011526, #184D59, #011526);
        background-size: 600% 600%;
        animation: animatedBackground 20s ease infinite;
        color: #F2D5DD;
        font-family: 'VT323', monospace;
        padding: 2rem;
    }

    @@keyframes animatedBackground {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    main {
        max-width: 900px;
        margin: 0 auto;
        background-color: rgba(1, 21, 38, 0.85);
        padding: 2rem;
        border-radius: 12px;
        animation: fadeUp 0.5s ease forwards;
    }

    h2, h4 {
        color: #F2D5DD;
    }

    hr {
        border-color: #F29D52;
    }

    label {
        color: #F2D5DD;
        font-weight: bold;
    }

    .form-control {
        background-color: rgba(1, 21, 38, 0.7);
        color: white !important;
        border: 1px solid #F29D52;
        border-radius: 6px;
    }

        .form-control:focus {
            background-color: rgba(1, 21, 38, 0.85);
            outline: none;
            border-color: #F2D5DD;
        }

    .btn-login {
        background-color: rgba(24, 77, 89, 0.8);
        color: #F2D5DD;
        border: 1px solid #F2D5DD;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.3s ease, color 0.3s ease;
        font-family: 'VT323', monospace;
    }

        .btn-login:hover {
            background-color: #F29D52;
            color: #011526;
        }

    a {
        color: #F29D52;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.3s ease;
    }

        a:hover {
            color: #F28B66;
            text-decoration: underline;
        }

    .text-danger {
        color: #F28B66 !important;
    }

    #socialLoginForm {
        margin-top: 2rem;
    }
</style>

<body class="login-page">
    <main aria-labelledby="title">
        <h2 id="title">@ViewBag.Title</h2>
        <div class="row">
            <div class="col-md-8">
                <section id="loginForm">
                    @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        <h4>Use a local account to log in.</h4>
                        <hr />
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="row mb-3">
                            @Html.LabelFor(m => m.Email, new { @class = "col-md-2 col-form-label" })
                            <div class="col-md-10">
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="row mb-3">
                            @Html.LabelFor(m => m.Password, new { @class = "col-md-2 col-form-label" })
                            <div class="col-md-10">
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="offset-md-2 col-md-10">
                                <div class="checkbox">
                                    @Html.CheckBoxFor(m => m.RememberMe)
                                    @Html.LabelFor(m => m.RememberMe)
                                </div>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="offset-md-2 col-md-10">
                                <input type="submit" value="Log in" class="btn-login" />
                            </div>
                        </div>
                        <p>
                            @Html.ActionLink("Register as a new user", "Register")
                        </p>
                    }
                </section>
            </div>
            <div class="col-md-4">
                <section id="socialLoginForm">
                    @Html.Partial("_ExternalLoginsListPartial", new ExternalLoginListViewModel { ReturnUrl = ViewBag.ReturnUrl })
                </section>
            </div>
        </div>
    </main>
</body>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
