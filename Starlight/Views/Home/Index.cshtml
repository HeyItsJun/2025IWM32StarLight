@{
    ViewBag.Title = "Home Page";
}

<link href="https://fonts.googleapis.com/css2?family=Shrikhand&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">

<style>
    :root {
        --accent-color: #ffd166;
        --body-font: 'VT323', monospace;
        --overlay-color: rgba(0,0,0,0.45);
        --title-font: 'Shrikhand', sans-serif;
        --subtitle-font: 'VT323', sans-serif;
    }

    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        width: 100%;
        background-attachment: fixed;
        background-image: url('https://images.squarespace-cdn.com/content/v1/53a05cdee4b0c1bc44841a7b/1523918458259-0AY7O6SCPK0SL3UPUB4Z/25+cinemagraphs+from+around+the+world');
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
    }

    .homepage-hero {
        background: none; 
        height: 100vh; 
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    header.homepage-hero h1#siteTitle {
        margin: 0 0 0.35rem 0;
        font-family: var(--title-font);
        font-size: clamp(2.2rem, 6.5vw, 5rem);
        line-height: 1;
        letter-spacing: 0.02em;
        font-weight: 700;
        text-transform: none;
        display: inline-block;
        padding: 0.2rem 0.5rem;
        background: linear-gradient(270deg, #ffffff, #2596be, #c2aa9d, #ffffff);
        background-size: 800% 800%;
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        text-shadow: 0 6px 18px rgba(0,0,0,0.5);
        animation: fadeUp 600ms ease-out both;
    }

    .hero-subtitle{
        margin-top: 0.6rem;
        margin-bottom: 1.25rem;
        font-family: var(--subtitle-font);
        font-size: clamp(1rem, 2.4vw, 1.4rem);
        color: #f7f7f7;
        opacity: 0.95;
        animation: fadeUp 900ms ease-out both;
        animation-delay: 120ms;
    }

    .hero-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .hero-cta a{
        display: inline-block;
        margin-top: .6rem;
        padding: .6rem 1rem;
        border-radius: 8px;
        text-decoration: none;
        font-family: var(--body-font);
        font-weight: 500;
        box-shadow: 0 6px 18px rgba(0,0,0,0.28);
        background: rgba(255,255,255,0.12);
        color: white;
        backdrop-filter: blur(4px);
        transition: transform .16s ease, background .16s ease;
    }
    .hero-cta a:hover{ transform: translateY(-3px); background: rgba(255,255,255,0.18); }

    @@keyframes fadeUp{
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@media (max-width: 520px){
        .homepage-hero{ padding: 1.5rem 0; }
        #siteTitle{ font-size: 2.25rem; }
    }
</style>


<main>
    <header class="homepage-hero" role="banner" aria-labelledby="siteTitle" aria-describedby="siteDescription">
        <div class="hero-content">
            <!-- Title -->
            <h1 id="siteTitle" class="display-1" role="heading" aria-level="1">ST✰RLIGHT</h1>

            <!-- Description -->
            <p id="siteDescription" class="hero-subtitle">
                Haz de los viajes de tus sueños una realidad tangible.
            </p>

            <!-- Explore button -->
            <p class="hero-cta">
                <a href="@Url.Action("Index", "Videos")" role="button" aria-labelledby="explore">Explora St✰rLight &raquo;</a>
            </p>
        </div>
    </header>
</main>