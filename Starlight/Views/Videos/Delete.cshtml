@model Starlight.Models.Video

@{
    ViewBag.Title = "Delete";
}

<style>
    body.delete-page {
        background: linear-gradient(270deg, #011526, #184D59, #011526);
        background-size: 600% 600%;
        animation: animatedBackground 20s ease infinite;
        color: #F2D5DD;
        font-family: 'VT323', monospace;
        padding: 2rem;
    }

    @@keyframes animatedBackground {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .delete-container {
        background-color: rgba(1, 21, 38, 0.75);
        padding: 2rem;
        border-radius: 12px;
        max-width: 800px;
        margin: 0 auto;
        animation: fadeUp 0.5s ease forwards;
    }

    dt {
        font-weight: bold;
        margin-top: 1rem;
        color: #F2D5DD;
    }

    dd {
        margin-left: 1.5rem;
        margin-bottom: 0.5rem;
        color: #F2D5DD;
    }

    h2, h3, h4 {
        color: #F2D5DD;
    }

    .btn-delete {
        background-color: rgba(24, 77, 89, 0.8);
        color: #F2D5DD;
        border: 1px solid #F2D5DD;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.3s ease, color 0.3s ease;
        font-family: 'VT323', monospace;
    }

        .btn-delete:hover {
            background-color: #F29D52;
            color: #011526;
        }

    a {
        color: #F29D52;
        font-weight: 600;
        text-decoration: none;
        margin-left: 1rem;
        transition: color 0.3s ease;
    }

        a:hover {
            color: #F28B66;
            text-decoration: underline;
        }
</style>

<body class="delete-page">
    <div class="delete-container">

        <h2>Delete</h2>

        <h3>Are you sure you want to delete this?</h3>
        <div>
            <h4>Video</h4>
            <hr />
            <dl class="dl-horizontal">
                <dt>
                    @Html.DisplayNameFor(model => model.Country)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Country)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.Community)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Community)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.Province)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Province)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.Resource)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Resource)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.TravelType)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.TravelType)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.Format)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Format)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.LikedColors)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.LikedColors)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.Music)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Music)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.Score)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Score)
                </dd>

            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-actions no-color">
                    <input type="submit" value="Delete" class="btn btn-default" /> |
                    @Html.ActionLink("Back to List", "Index")
                </div>
            }
        </div>
    </div>
</body>